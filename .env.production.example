# ==============================================================================
# Environment Configuration Template for Production (Debian Linux VPS)
# Salin berkas ini ke .env sebelum menjalankan docker compose
# ==============================================================================

APP_NAME="E-Management Polbangtan Malang"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://asrama.polbangtanmalang.ac.id

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Database (MySQL 8.0 Container)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=asrama-db
DB_PORT=3306
DB_DATABASE=polbangtan_asrama
DB_USERNAME=polbangtan_user
DB_PASSWORD=GantiDenganPasswordDatabaseYangSangatKuat123!
DB_ROOT_PASSWORD=GantiDenganRootPasswordDatabaseYangSangatKuat123!

# ------------------------------------------------------------------------------
# In-Memory Cache, Session & Queue (Redis 7 Container)
# ------------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=525600
SESSION_COOKIE=asrama_session
# Setel ke 'true' HANYA jika sudah menggunakan HTTPS/SSL. Jika via HTTP (port 8000), set 'false' agar tidak error 419.
SESSION_SECURE_COOKIE=false

REDIS_CLIENT=phpredis
REDIS_HOST=asrama-redis
REDIS_PASSWORD=GantiDenganPasswordRedisYangKuat123!
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ------------------------------------------------------------------------------
# Mail Configuration (SMTP Production)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@polbangtanmalang.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Single Sign-On (SSO) Integrasi ke E-Klinik / E-Polbangtan HealtCare
# ------------------------------------------------------------------------------
KONSELING_URL=https://klinik.polbangtanmalang.ac.id/sso/verify
KONSELING_SSO_SECRET=GantiDenganSecretHmacSsoYangSamaDenganEklinik!

# ------------------------------------------------------------------------------
# Docker Deployment Flags
# ------------------------------------------------------------------------------
# Setel ke 'true' jika ingin migrasi database otomatis dijalankan saat container boot
RUN_MIGRATIONS=false

# Port Nginx yang di-expose ke loopback host (127.0.0.1:8000)
DOCKER_APP_PORT=8000
